# ---------------------------------------------------------------------------
# Frontend environment (Vite)
#
# Only PUBLIC values belong here. Everything prefixed with VITE_ is embedded
# into the browser bundle and is readable by anyone.
#
# NEVER put provider or payment credentials in this file or in any frontend
# code: TripJack keys/passwords, Supabase service-role keys, Razorpay secrets,
# OpenAI keys, SMS keys and database credentials live only in the FastAPI
# backend environment (see backend/.env.example).
# ---------------------------------------------------------------------------

# Public base URL of the Fly n Feel FastAPI booking backend.
# Local development:
VITE_BOOKING_API_URL=http://localhost:8000
# Production example:
# VITE_BOOKING_API_URL=https://api.flynfeelholidays.com

# ---- Supabase (PUBLIC values only) ----------------------------------------
# Project URL and the anon/publishable key. Both are safe to expose; they are
# protected by Row Level Security. Sign-in/sign-up activates automatically
# once these two are set.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# There is deliberately NO VITE_SUPABASE_SERVICE_ROLE_KEY. If you ever see
# one, it is a security incident.

# ---- Test-only switches (no credentials) ----------------------------------
# "true" forces the local mock checkout even when a backend URL is set.
VITE_BOOKING_TEST_CHECKOUT=true
# "true" forces mock hotel results until the hotel backend is live.
VITE_HOTEL_TEST_MODE=true

# Razorpay: only the PUBLIC key id may ever appear here, and only once
# payments go live. The Razorpay secret is backend-only.
# VITE_RAZORPAY_KEY_ID=
