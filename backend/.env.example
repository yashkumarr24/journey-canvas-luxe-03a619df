# Copy to .env for local development. NEVER commit a real .env.
# No value in this file is a real credential.

# ---- application ----
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ---- frontend / CORS ----
# Primary frontend origin (no trailing slash)
FRONTEND_URL=http://localhost:8080
# Extra allowed origins, comma-separated. REQUIRED in production. Never "*".
CORS_ALLOWED_ORIGINS=http://localhost:8080,https://your-site.vercel.app
# Optional regex for preview subdomains (Lovable / Vercel previews)
# CORS_ALLOWED_ORIGIN_REGEX=^https://([a-z0-9-]+\.)*(lovable\.app|vercel\.app)$

# ---- Supabase (placeholders only — one project PER environment) ----
# dev / UAT / production each get their own project URL and keys.
SUPABASE_URL=
# Public key. Only used if/when client-side auth is added; safe to expose.
SUPABASE_ANON_KEY=
# BACKEND ONLY. Full database access, bypasses RLS. Never ship to the browser,
# never commit, never place in any VITE_ variable.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string, used only to apply migrations.
SUPABASE_DB_URL=

# ---- TripJack (BACKEND ONLY — set these on the VPS, never in the frontend) ----
# Staging/UAT host. Production has a different host AND a different key.
TRIPJACK_BASE_URL=https://apitest.tripjack.com
# Sent as the `apikey` request header. Never commit a real value.
TRIPJACK_API_KEY=
# Timeouts in seconds; flight search is slow, so read timeout is generous.
TRIPJACK_CONNECT_TIMEOUT=5
TRIPJACK_READ_TIMEOUT=40
TRIPJACK_WRITE_TIMEOUT=10
TRIPJACK_POOL_TIMEOUT=5
TRIPJACK_MAX_CONNECTIONS=20
# Retries apply to SEARCH ONLY (idempotent). Booking will never retry.
TRIPJACK_SEARCH_RETRIES=1

# Set to true ONLY when running behind a trusted reverse proxy (nginx/Caddy).
# Otherwise clients can spoof X-Forwarded-For and evade rate limiting.
TRUST_PROXY_HEADERS=false

# ---- Razorpay (NOT used yet — leave blank) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- AI travel assistant (BACKEND ONLY — never in any VITE_ variable) ----
# "demo" = rule-based assistant, no credentials needed. "openai" activates the
# OpenAI provider and requires OPENAI_API_KEY.
ASSISTANT_PROVIDER=demo
# Never commit a real value. The browser must never receive this key.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT=25

# ---- Notifications: email (BACKEND ONLY — never a VITE_ variable) ----
# "demo" records the attempt and sends nothing. "resend" sends real email and
# requires BOTH values below; if either is missing the service stays on demo.
NOTIFICATIONS_EMAIL_PROVIDER=demo
# Resend API key with SENDING permission only, restricted to the Fly n Feel
# sending domain. Never commit a real value.
RESEND_API_KEY=
# Must use a domain verified in Resend, e.g. "Fly n Feel <bookings@flynfeelholidays.com>"
RESEND_FROM_EMAIL=
