# Copy to .env for local development. NEVER commit a real .env.
# No value in this file is a real credential.

# ---- application ----
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ---- frontend / CORS ----
# Primary frontend origin (no trailing slash)
FRONTEND_URL=http://localhost:8080
# Extra allowed origins, comma-separated. REQUIRED in production. Never "*".
CORS_ALLOWED_ORIGINS=http://localhost:8080,https://your-site.vercel.app
# Optional regex for preview subdomains (Lovable / Vercel previews)
# CORS_ALLOWED_ORIGIN_REGEX=^https://([a-z0-9-]+\.)*(lovable\.app|vercel\.app)$

# ---- Supabase (placeholders only — one project PER environment) ----
# dev / UAT / production each get their own project URL and keys.
SUPABASE_URL=
# Public key. Only used if/when client-side auth is added; safe to expose.
SUPABASE_ANON_KEY=
# BACKEND ONLY. Full database access, bypasses RLS. Never ship to the browser,
# never commit, never place in any VITE_ variable.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string, used only to apply migrations.
SUPABASE_DB_URL=

# ---- TripJack (NOT used yet — leave blank) ----
TRIPJACK_BASE_URL=
TRIPJACK_API_KEY=

# ---- Razorpay (NOT used yet — leave blank) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
